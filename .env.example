# MoveInSync Settlement Engine Configuration Template

# Server Port
SERVER_PORT=8080

# Active Spring Profile (local | test | prod)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration (Used in 'prod' profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=settlement_db
DB_USER=postgres
DB_PASSWORD=postgres_secure_password_placeholder

# Settlement Business Parameters
SETTLEMENT_TIMEZONE=Asia/Kolkata
SETTLEMENT_RECONCILIATION_TOLERANCE_RUPEES=100.00
SETTLEMENT_TDS_MONTHLY_THRESHOLD_RUPEES=30000.00
SETTLEMENT_TDS_TAX_RATE_PERCENTAGE=5.00
